{
  "_comment": "SDXL + ControlNet Canny background replacement workflow for ComfyUI",
  "1": {
    "class_type": "LoadImage",
    "inputs": { "image": "INPUT_IMAGE.png" }
  },
  "2": {
    "class_type": "CannyEdgePreprocessor",
    "inputs": { "image": ["1", 0], "low_threshold": 100, "high_threshold": 200, "resolution": 1024 }
  },
  "3": {
    "class_type": "CheckpointLoaderSimple",
    "inputs": { "ckpt_name": "sd_xl_base_1.0.safetensors" }
  },
  "4": {
    "class_type": "CLIPTextEncode",
    "inputs": { "text": "product photography, marble table, studio lighting, professional, 4K, clean background", "clip": ["3", 1] }
  },
  "5": {
    "class_type": "CLIPTextEncode",
    "inputs": { "text": "blurry, distorted, cartoon, watermark, text, low quality", "clip": ["3", 1] }
  },
  "6": {
    "class_type": "ControlNetLoader",
    "inputs": { "control_net_name": "control-lora-canny-rank256.safetensors" }
  },
  "7": {
    "class_type": "ControlNetApplyAdvanced",
    "inputs": {
      "positive": ["4", 0], "negative": ["5", 0],
      "control_net": ["6", 0], "image": ["2", 0],
      "strength": 0.65, "start_percent": 0.0, "end_percent": 0.85
    }
  },
  "8": {
    "class_type": "EmptyLatentImage",
    "inputs": { "width": 1024, "height": 1024, "batch_size": 1 }
  },
  "9": {
    "class_type": "KSampler",
    "inputs": {
      "model": ["3", 0], "positive": ["7", 0], "negative": ["7", 1],
      "latent_image": ["8", 0], "seed": 42, "steps": 25, "cfg": 7.0,
      "sampler_name": "euler_ancestral", "scheduler": "normal", "denoise": 0.85
    }
  },
  "10": {
    "class_type": "VAEDecode",
    "inputs": { "samples": ["9", 0], "vae": ["3", 2] }
  },
  "11": {
    "class_type": "SaveImage",
    "inputs": { "images": ["10", 0], "filename_prefix": "snapclip_bg" }
  }
}
